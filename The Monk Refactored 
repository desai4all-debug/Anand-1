//+------------------------------------------------------------------+
//| CRC32 CALCULATION (FIX #1)                                      |
//+------------------------------------------------------------------+
uint32 CRC32_Calculate(const void &data[], int size)
{
   uint32 crc = 0xFFFFFFFF;
   uint32 poly = 0xEDB88320;
   for(int i = 0; i < size; i++)
   {
      uint8 byte = ((uint8&)data[i]);
      crc ^= byte;
      for(int j = 0; j < 8; j++)
         crc = (crc & 1) ? (crc >> 1) ^ poly : crc >> 1;
   }
   return crc ^ 0xFFFFFFFF;
}

