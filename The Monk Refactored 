//+------------------------------------------------------------------+
//| BROADCAST FEED (FIX #1: Atomic Double-Buffering)               |
//+------------------------------------------------------------------+
void BroadcastFeed()
{
   int h = FeedFileOpen(NodeID, FILE_READ | FILE_WRITE | FILE_BIN | FILE_COMMON | FILE_SHARE_READ | FILE_SHARE_WRITE);
   if(h == INVALID_HANDLE)
   {
      h = FeedFileOpen(NodeID, FILE_WRITE | FILE_BIN | FILE_COMMON | FILE_SHARE_READ | FILE_SHARE_WRITE);
      if(h == INVALID_HANDLE) return;
   }
   
   FileSeek(h, 0, SEEK_SET);
   uint curVer = (FileSize(h) >= 4) ? (uint)FileReadInteger(h) : 0;
   
   FileSeek(h, 0, SEEK_SET);
   FileWriteInteger(h, (int)(curVer + 1));
   FileWriteInteger(h, symCount);
   FileWriteInteger(h, 0);
   FileWriteInteger(h, 0);
   
   long wallMs = TimeCurrentMsc();
   
   for(int i = 0; i < symCount; i++)
   {
      string s = symArr[i];
      if(!SymbolSelect(s, true)) continue;
      
      double bid = SymbolInfoDouble(s, SYMBOL_BID);
      double ask = SymbolInfoDouble(s, SYMBOL_ASK);
      double pt = SymbolInfoDouble(s, SYMBOL_POINT);
      double spread = (pt > 0) ? (ask - bid) / pt : 0.0;
      
      FileSeek(h, HEADER_BYTES + i * ENTRY_BYTES, SEEK_SET);
      FileWriteDouble(h, bid);
      FileWriteDouble(h, ask);
      FileWriteDouble(h, (double)wallMs);
      FileWriteDouble(h, spread);
      
      double data[] = {bid, ask, (double)wallMs, spread};
      uint32 crc = CRC32_Calculate(data, 32);
      FileWriteInteger(h, (int)crc);
      
      if(EnableTickLog && logHandle != INVALID_HANDLE)
      {
         logTick++;
         if(logTick % LogEveryNTicks == 0)
         {
            MqlDateTime dt;
            TimeToStruct(TimeCurrent(), dt);
            string dateStr = StringFormat("%04d.%02d.%02d", dt.year, dt.mon, dt.day);
            string timeStr = StringFormat("%02d:%02d:%02d", dt.hour, dt.min, dt.sec);
            FileWrite(logHandle, dateStr, timeStr, s, bid, ask, spread, wallMs);
         }
      }
   }
   
   FileSeek(h, 0, SEEK_SET);
   FileWriteInteger(h, (int)(curVer + 2));
   FileClose(h);
}

//+------------------------------------------------------------------+
//| READ FEED (FIX #1: CRC Validation, FIX #5: Offline Detection)  |
//+------------------------------------------------------------------+
bool ReadFeed(string masterNode, LocalFeed &feeds[], int &cnt)
{
   int h = FeedFileOpen(masterNode, FILE_READ | FILE_BIN | FILE_COMMON | FILE_SHARE_READ | FILE_SHARE_WRITE);
   if(h == INVALID_HANDLE) return false;
   
   long fsize = FileSize(h);
   if(fsize < HEADER_BYTES) { FileClose(h); return false; }
   
   FileSeek(h, 0, SEEK_SET);
   uint v1 = (uint)FileReadInteger(h);
   
   if(v1 == 0) { healthCheck.masterOnline = false; FileClose(h); return false; }
   if(v1 % 2 != 0) { FileClose(h); return false; }
   
   cnt = FileReadInteger(h);
   if(cnt <= 0 || cnt > MAX_SYMS || fsize < (long)(HEADER_BYTES + cnt * ENTRY_BYTES))
   { FileClose(h); return false; }
   
   if(ArraySize(feeds) < cnt) ArrayResize(feeds, cnt);
   
   for(int i = 0; i < cnt; i++)
   {
      FileSeek(h, HEADER_BYTES + i * ENTRY_BYTES, SEEK_SET);
      feeds[i].bid = FileReadDouble(h);
      feeds[i].ask = FileReadDouble(h);
      feeds[i].ts_ms = FileReadDouble(h);
      feeds[i].spread = FileReadDouble(h);
      feeds[i].crc = (uint32)FileReadInteger(h);
      
      double data[] = {feeds[i].bid, feeds[i].ask, feeds[i].ts_ms, feeds[i].spread};
      uint32 calcCrc = CRC32_Calculate(data, 32);
      if(calcCrc != feeds[i].crc) { FileClose(h); return false; }
   }
   
   FileSeek(h, 0, SEEK_SET);
   uint v2 = (uint)FileReadInteger(h);
   FileClose(h);
   
   if(v1 == v2)
   {
      healthCheck.masterOnline = true;
      healthCheck.lastGoodFeed = TimeCurrent();
      healthCheck.consecutiveFailures = 0;
      return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| PROCESS ARBITRAGE                                               |
//+------------------------------------------------------------------+
void ProcessArbitrage()
{
   LocalFeed feeds[];
   int feedCnt = 0;
   
   if(!ReadFeed(MasterNodeID, feeds, feedCnt)) return;
   if(feedCnt != symCount) { Comment("⚠️ Symbol mismatch: master=", feedCnt, " local=", symCount); return; }
   
   for(int i = 0; i < symCount; i++)
   {
      string s = symArr[i];
      if(!SymbolSelect(s, true)) continue;
      
      double mBid = feeds[i].bid;
      double mAsk = feeds[i].ask;
      if(mBid <= 0.0 || mAsk <= 0.0) continue;
      
      double lBid = SymbolInfoDouble(s, SYMBOL_BID);
      double lAsk = SymbolInfoDouble(s, SYMBOL_ASK);
      double pt = SymbolInfoDouble(s, SYMBOL_POINT);
      double pipSz = pt * 10.0;
      double lSpread = (pt > 0.0) ? (lAsk - lBid) / pt : 0.0;
      
      long nowMs = TimeCurrentMsc();
      double latencyMs = (double)(nowMs - (long)feeds[i].ts_ms);
      if(latencyMs < 0.0) latencyMs = 0.0;
      
      if(latencyMs > MaxLatencyMs) { confirmState[i].ticks = 0; continue; }
      if(lSpread > MaxSpreadPoints) { confirmState[i].ticks = 0; continue; }
      
      double gap_buy = (mBid - lAsk) / pipSz;
      double gap_sell = (lBid - mAsk) / pipSz;
      double costPips = lSpread / 10.0;
      double minGap = MathMax(TriggerPips, MinGapPips) + costPips;
      
      ManagePositions(s, i, gap_buy, gap_sell);
      
      bool buyOK = (gap_buy > minGap);
      bool sellOK = (gap_sell > minGap);
      
      UpdateDisplay(s, gap_buy, gap_sell, latencyMs, lSpread, i);
      
      if(!buyOK && !sellOK) { confirmState[i].ticks = 0; continue; }
      
      // FIX #4: Per-symbol confirmation state machine
      if((confirmState[i].lastGapBuy > 0 && gap_buy <= 0) ||
         (confirmState[i].lastGapSell > 0 && gap_sell <= 0) ||
         (TimeCurrent() - confirmState[i].lastTickTime > 2))
      {
         confirmState[i].ticks = 0;
      }
      
      confirmState[i].lastGapBuy = gap_buy;
      confirmState[i].lastGapSell = gap_sell;
      confirmState[i].lastTickTime = TimeCurrent();
      confirmState[i].ticks++;
      
      if(confirmState[i].ticks < ConfirmTicks) continue;
      
      if(PositionsTotal() >= MaxTrades) continue;
      if(hourTrades >= MaxTradesPerHour) continue;
      if(dayTrades >= MaxTradesPerDay) continue;
      
      // FIX #2: Phantom delay via EventSetTimer
      if(PhantomMode && !phantomDelay.pending)
      {
         int range = MathMax(1, PhantomDelayMax - PhantomDelayMin);
         int delay = PhantomDelayMin + (MathRand() % range);
         phantomDelay.pending = true;
         phantomDelay.delayUntil = TimeCurrent() + delay / 1000.0;
         phantomDelay.symbol = s;
         phantomDelay.symbolIndex = i;
         phantomDelay.gapValue = buyOK ? gap_buy : gap_sell;
         confirmState[i].ticks = 0;
         continue;
      }
      
      if(!PhantomMode)
      {
         double lot = CalcLot(s);
         ExecuteTradeWithRetry(s, buyOK ? ORDER_TYPE_BUY : ORDER_TYPE_SELL, lot, buyOK ? gap_buy : gap_sell);
         if(Strategy == STRAT_2LEG_HEDGE)
            WriteHedgeSignal(NodeID, s, buyOK ? -(lot * HedgeRatio) : (lot * HedgeRatio));
         confirmState[i].ticks = 0;
      }
   }
}

//+------------------------------------------------------------------+
//| EXECUTE TRADE WITH RETRY (FIX #8: Requote Retry)               |
//+------------------------------------------------------------------+
bool ExecuteTradeWithRetry(string sym, ENUM_ORDER_TYPE type, double lot, double gapPips)
{
   for(int attempt = 0; attempt < MAX_RETRIES; attempt++)
   {
      double price = (type == ORDER_TYPE_BUY) ? SymbolInfoDouble(sym, SYMBOL_ASK) : SymbolInfoDouble(sym, SYMBOL_BID);
      double pt = SymbolInfoDouble(sym, SYMBOL_POINT);
      double sl = (StopLossPips > 0) ? (type == ORDER_TYPE_BUY ? price - StopLossPips * pt * 10 : price + StopLossPips * pt * 10) : 0.0;
      double tp = (TakeProfitPips > 0) ? (type == ORDER_TYPE_BUY ? price + TakeProfitPips * pt * 10 : price - TakeProfitPips * pt * 10) : 0.0;
      
      bool res = (type == ORDER_TYPE_BUY) ? trade.Buy(lot, sym, price, sl, tp, BuildComment(sym, gapPips))
                                          : trade.Sell(lot, sym, price, sl, tp, BuildComment(sym, gapPips));
      
      if(res)
      {
         if(!PaperMode) Print("✅ ", NodeID, " | ", EnumToString(type), " ", sym, " lot=", lot, " ticket=", trade.ResultOrder());
         hourTrades++;
         dayTrades++;
         return true;
      }
      
      uint retcode = trade.ResultRetcode();
      if(retcode != TRADE_RETCODE_REQUOTE) break;
      if(attempt < MAX_RETRIES - 1) Sleep(RETRY_DELAY_MS);
   }
   Print("❌ ", NodeID, " | Trade FAILED ", sym);
   return false;
}

//+------------------------------------------------------------------+
//| PROCESS HEDGE SIGNALS (FIX #9: ACK Mechanism)                  |
//+------------------------------------------------------------------+
void ProcessHedgeSignals()
{
   for(int j = 0; j < slaveCount; j++)
   {
      if(slaveArr[j] == "") continue;
      for(int i = 0; i < symCount; i++)
      {
         string s = symArr[i];
         double signalLot;
         datetime sigTime;
         bool acked;
         
         if(!ReadHedgeSignal(slaveArr[j], s, signalLot, sigTime, acked)) continue;
         if(TimeCurrent() - sigTime > 5) continue;
         
         ENUM_ORDER_TYPE hedgeType = (signalLot > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
         double lot = MathAbs(signalLot);
         double minLot = SymbolInfoDouble(s, SYMBOL_VOLUME_MIN);
         double lotStep = SymbolInfoDouble(s, SYMBOL_VOLUME_STEP);
         double maxLot = SymbolInfoDouble(s, SYMBOL_VOLUME_MAX);
         lot = MathFloor(lot / lotStep) * lotStep;
         lot = MathMax(minLot, MathMin(maxLot, lot));
         
         ExecuteTradeWithRetry(s, hedgeType, lot, 0.0);
         WriteHedgeACK(slaveArr[j], s);
      }
   }
}

//+------------------------------------------------------------------+
//| MANAGE POSITIONS                                                |
//+------------------------------------------------------------------+
void ManagePositions(string sym, int idx, double gapBuy, double gapSell)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(PositionGetSymbol(i) != sym) continue;
      if(PositionGetInteger(POSITION_MAGIC) != MagicNumber) continue;
      
      ulong ticket = PositionGetInteger(POSITION_TICKET);
      double profit = PositionGetDouble(POSITION_PROFIT);
      datetime otime = (datetime)PositionGetInteger(POSITION_TIME);
      int posType = (int)PositionGetInteger(POSITION_TYPE);
      
      bool expired = (TimeCurrent() - otime >= TradeExpirySec);
      bool gapClosed = (posType == POSITION_TYPE_BUY) ? (gapBuy < TriggerPips * 0.30) : (gapSell < TriggerPips * 0.30);
      
      if(gapClosed || expired)
      {
         if(!PaperMode) trade.PositionClose(ticket);
      }
   }
}

//+------------------------------------------------------------------+
//| LOT CALCULATION (FIX #11: Guarded Access)                      |
//+------------------------------------------------------------------+
double CalcLot(string sym)
{
   if(!AutoLot) return NormLot(sym, ManualLot);
   
   double bal = SafeAccountInfoDouble(ACCOUNT_BALANCE);
   if(bal <= 0.0) return NormLot(sym, ManualLot);
   
   double tickVal = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_VALUE);
   double tickSz = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);
   double pt = SymbolInfoDouble(sym, SYMBOL_POINT);
   
   if(tickVal <= 0.0 || tickSz <= 0.0 || pt <= 0.0) return NormLot(sym, ManualLot);
   
   double pipValue = tickVal * (pt * 10.0) / tickSz;
   if(pipValue <= 0.0) return NormLot(sym, ManualLot);
   
   double riskAmt = bal * RiskPercent / 100.0;
   double lot = riskAmt / (MathMax(TriggerPips, 1.0) * pipValue);
   
   return NormLot(sym, lot);
}

double NormLot(string sym, double lot)
{
   double minLot = SymbolInfoDouble(sym, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(sym, SYMBOL_VOLUME_MAX);
   double lotStep = SymbolInfoDouble(sym, SYMBOL_VOLUME_STEP);
   if(lotStep <= 0.0) lotStep = 0.01;
   lot = MathFloor(lot / lotStep) * lotStep;
   return MathMax(minLot, MathMin(maxLot, lot));
}

