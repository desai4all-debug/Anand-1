string BuildComment(string sym, double gap)
{
   if(!RandomComment) return "MONK_" + StringSubstr(sym, 0, 10);
   string pool[] = {"S", "T", "A", "R", "T", "E", "D"};
   int idx = MathRand() % 7;
   string cmt = pool[idx] + IntegerToString(100 + MathRand() % 999);
   return StringSubstr(cmt, 0, 32);
}

//+------------------------------------------------------------------+
//| DAILY LOSS GUARD                                                |
//+------------------------------------------------------------------+
bool DailyLossOK()
{
   double equity = SafeAccountInfoDouble(ACCOUNT_EQUITY);
   double balance = SafeAccountInfoDouble(ACCOUNT_BALANCE);
   if(equity > equityPeak) equityPeak = equity;
   double loss = (dailyStartBal > 0) ? (dailyStartBal - balance) / dailyStartBal * 100.0 : 0.0;
   return (loss < MaxDailyLossPct);
}

