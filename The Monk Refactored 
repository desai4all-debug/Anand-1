//| ROLL COUNTERS                                                    |
//+------------------------------------------------------------------+
void RollCounters()
{
   datetime now = TimeCurrent();
   if(now - lastHourReset >= 3600) { hourTrades = 0; lastHourReset = now; }
   if(now - lastDayReset >= 86400) { dayTrades = 0; dailyStartBal = SafeAccountInfoDouble(ACCOUNT_BALANCE); lastDayReset = now; }
}

//+------------------------------------------------------------------+
//| HEDGE SIGNAL I/O (FIX #9: ACK)                                 |
//+------------------------------------------------------------------+
void WriteHedgeSignal(string slaveNodeID, string sym, double signalLot)
{
   string fname = HEDGE_FILE_PREFIX + slaveNodeID + "_" + sym + ".bin";
   int h = FileOpen(fname, FILE_WRITE | FILE_BIN | FILE_COMMON | FILE_SHARE_READ | FILE_SHARE_WRITE);
   if(h == INVALID_HANDLE) return;
   FileWriteDouble(h, signalLot);
   FileWriteDouble(h, (double)TimeCurrent());
   FileWriteDouble(h, 0.0);
   FileClose(h);
}

bool ReadHedgeSignal(string slaveNodeID, string sym, double &lot, datetime &ts, bool &acked)
{
   string fname = HEDGE_FILE_PREFIX + slaveNodeID + "_" + sym + ".bin";
   if(!FileIsExist(fname, FILE_COMMON)) return false;
   
   int h = FileOpen(fname, FILE_READ | FILE_BIN | FILE_COMMON | FILE_SHARE_READ | FILE_SHARE_WRITE);
   if(h == INVALID_HANDLE) return false;
   
   lot = FileReadDouble(h);
   ts = (datetime)FileReadDouble(h);
   acked = (FileReadDouble(h) != 0.0);
   FileClose(h);
   
   return (lot != 0.0 && !acked);
}

void WriteHedgeACK(string slaveNodeID, string sym)
{
   string fname = HEDGE_FILE_PREFIX + slaveNodeID + "_" + sym + ".bin";
   if(!FileIsExist(fname, FILE_COMMON)) return;
   
   int h = FileOpen(fname, FILE_READ | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   double lot = FileReadDouble(h);
   double ts = FileReadDouble(h);
   FileClose(h);
   
   h = FileOpen(fname, FILE_WRITE | FILE_BIN | FILE_COMMON);
   FileWriteDouble(h, lot);
   FileWriteDouble(h, ts);
   FileWriteDouble(h, 1.0);
   FileClose(h);
}

//+------------------------------------------------------------------+
//| HEALTH CHECK WATCHDOG (FIX #6)                                 |
//+------------------------------------------------------------------+
void PerformHealthCheck()
{
   int h = FeedFileOpen(MasterNodeID, FILE_READ | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      healthCheck.consecutiveFailures++;
      if(healthCheck.consecutiveFailures > 3) Alert("Feed file inaccessible: ", MasterNodeID);
      return;
   }
   FileClose(h);
   
   if(!SymbolSelect(symArr[0], true)) { Alert("Lost connection to broker"); return; }
   
   // FIX #5: Master offline timeout
   if(!healthCheck.masterOnline && TimeCurrent() - healthCheck.lastGoodFeed > FEED_TIMEOUT_SEC)
   {
      Alert("MONK ELITE: Master feed offline for > ", FEED_TIMEOUT_SEC, "s");
      Comment("⛔ MASTER OFFLINE — Manual intervention required");
      return;
   }
   
   Print("✓ Heartbeat OK | Positions: ", PositionsTotal(), " | Feed: ", healthCheck.masterOnline ? "OK" : "WAITING");
}

//+------------------------------------------------------------------+
//| FILE CLEANUP (FIX #3)                                           |
//+------------------------------------------------------------------+
void PerformFileCleanup()
{
   if(logHandle != INVALID_HANDLE && FileSize(logHandle) > MAX_LOG_SIZE_MB * 1024 * 1024)
   {
      FileClose(logHandle);
      MqlDateTime dt;
      TimeToStruct(TimeCurrent(), dt);
      string datePart = StringFormat("%04d-%02d-%02d", dt.year, dt.mon, dt.day);
      string fname = "MONK_TICKS_" + NodeID + "_" + datePart + ".csv";
      logHandle = FileOpen(fname, FILE_WRITE | FILE_COMMON | FILE_CSV | FILE_ANSI);
      if(logHandle != INVALID_HANDLE)
         FileWrite(logHandle, "Date", "Time", "Symbol", "Bid", "Ask", "Spread_pts", "WallClock_ms");
   }
   
   for(int s = 0; s < symCount; s++)
   {
      for(int n = 1; n <= 8; n++)
      {
         string fname = HEDGE_FILE_PREFIX + "NODE" + IntegerToString(n) + "_" + symArr[s] + ".bin";
         if(FileIsExist(fname, FILE_COMMON))
         {
            int h = FileOpen(fname, FILE_READ | FILE_BIN | FILE_COMMON);
            if(h != INVALID_HANDLE)
            {
               double ts = FileReadDouble(h);
               FileReadDouble(h);
               double ack = FileReadDouble(h);
               FileClose(h);
               if(ack != 0.0 || TimeCurrent() - (datetime)ts > 60) FileDelete(fname, FILE_COMMON);
            }
         }
      }
   }
}

