void UpdateDisplay(string sym, double gapBuy, double gapSell, double latMs, double spread, int idx)
{
   if(TimeCurrent() - lastDisplay < 1) return;
   lastDisplay = TimeCurrent();
   
   string gapBuyStr = (gapBuy > 0) ? "+" + DoubleToString(gapBuy, 2) : DoubleToString(gapBuy, 2);
   string gapSellStr = (gapSell > 0) ? "+" + DoubleToString(gapSell, 2) : DoubleToString(gapSell, 2);
   
   Comment(
      "🧘 THE MONK ELITE v2.0 | Node: ", NodeID, "\n",
      "Strategy: ", EnumToString(Strategy), " | Master: ", MasterNodeID, "\n",
      "Symbol: ", sym, " | Gap Buy: ", gapBuyStr, "p | Gap Sell: ", gapSellStr, "p\n",
      "Spread: ", DoubleToString(spread, 1), "pts | Latency: ", DoubleToString(latMs, 1), "ms\n",
      "Confirm: ", confirmState[idx].ticks, "/", ConfirmTicks, " | Positions: ", PositionsTotal(), "/", MaxTrades, "\n",
      "H/D Trades: ", hourTrades, "/", dayTrades, " | Daily P&L: ", DoubleToString(SafeAccountInfoDouble(ACCOUNT_BALANCE) - dailyStartBal, 2), "\n",
      "Master: ", healthCheck.masterOnline ? "🟢 ONLINE" : "🔴 OFFLINE", " | ", PaperMode ? "⚠️ PAPER MODE" : "🟢 LIVE MODE", "\n"
   );
}

