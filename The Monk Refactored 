void OnTimer()
{
   if(TimeCurrent() - healthCheck.lastCheck >= HEARTBEAT_INTERVAL_SEC)
   {
      PerformHealthCheck();
      healthCheck.lastCheck = TimeCurrent();
   }
   
   if(TimeCurrent() - lastFileCleanup >= FILE_CLEANUP_INTERVAL)
   {
      PerformFileCleanup();
      lastFileCleanup = TimeCurrent();
   }
   
   if(phantomDelay.pending && TimeCurrent() >= phantomDelay.delayUntil)
   {
      phantomDelay.pending = false;
      
      LocalFeed feeds[];
      int feedCnt = 0;
      if(ReadFeed(MasterNodeID, feeds, feedCnt) && feedCnt > phantomDelay.symbolIndex)
      {
         double mBid = feeds[phantomDelay.symbolIndex].bid;
         double mAsk = feeds[phantomDelay.symbolIndex].ask;
         double lBid = SymbolInfoDouble(phantomDelay.symbol, SYMBOL_BID);
         double lAsk = SymbolInfoDouble(phantomDelay.symbol, SYMBOL_ASK);
         double pt = SymbolInfoDouble(phantomDelay.symbol, SYMBOL_POINT);
         double pipSz = pt * 10.0;
         
         double newGapBuy = (mBid - lAsk) / pipSz;
         double newGapSell = (lBid - mAsk) / pipSz;
         double lSpread = (pt > 0.0) ? (lAsk - lBid) / pt : 0.0;
         double costPips = lSpread / 10.0;
         double minGap = MathMax(TriggerPips, MinGapPips) + costPips;
         
         if(newGapBuy >= minGap || newGapSell >= minGap)
         {
            double lot = CalcLot(phantomDelay.symbol);
            ExecuteTradeWithRetry(phantomDelay.symbol, 
               (newGapBuy >= minGap) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL,
               lot, newGapBuy >= minGap ? newGapBuy : newGapSell);
         }
      }
   }
}

