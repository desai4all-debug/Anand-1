uint32 CRC32_Calculate(double bid, double ask, double ts_ms, double spread)
{
   uint32 crc = 0xFFFFFFFF;
   uint32 poly = 0xEDB88320;
   uchar buf[32];
   memcpy(buf, &bid, 8);
   memcpy(buf + 8, &ask, 8);
   memcpy(buf + 16, &ts_ms, 8);
   memcpy(buf + 24, &spread, 8);
   for(int i = 0; i < 32; i++)
   {
      crc ^= buf[i];
      for(int j = 0; j < 8; j++)
         crc = (crc & 1) ? (crc >> 1) ^ poly : crc >> 1;
   }
   return crc ^ 0xFFFFFFFF;
}

