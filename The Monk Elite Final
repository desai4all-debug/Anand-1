   double balance = SafeAccountInfoDouble(ACCOUNT_BALANCE);
   if(equity > equityPeak) equityPeak = equity;
   double loss = (dailyStartBal > 0) ? (dailyStartBal - balance) / dailyStartBal * 100.0 : 0.0;
   return (loss < MaxDailyLossPct);
}

void RollCounters()
{
   datetime now = TimeCurrent();
   if(now - lastHourReset >= 3600) { hourTrades = 0; lastHourReset = now; }
   if(now - lastDayReset >= 86400) { dayTrades = 0; dailyStartBal = SafeAccountInfoDouble(ACCOUNT_BALANCE); lastDayReset = now; }
}

