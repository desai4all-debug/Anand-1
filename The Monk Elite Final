   {
      PerformHealthCheck();
      healthCheck.lastCheck = TimeCurrent();
   }
   if(TimeCurrent() - lastFileCleanup >= FILE_CLEANUP_INTERVAL)
   {
      PerformFileCleanup();
      lastFileCleanup = TimeCurrent();
   }
   if(phantomDelay.pending && nowMs >= phantomDelay.delayUntilMs)
   {
      phantomDelay.pending = false;
      LocalFeed feeds[];
      int feedCnt = 0;
      if(ReadFeed(MasterNodeID, feeds, feedCnt) && feedCnt > phantomDelay.symbolIndex)
      {
         LocalFeed freshFeed = feeds[phantomDelay.symbolIndex];
         if(!freshFeed.valid) return;
         double mBid = freshFeed.bid;
         double mAsk = freshFeed.ask;
         double lBid = SymbolInfoDouble(phantomDelay.symbol, SYMBOL_BID);
         double lAsk = SymbolInfoDouble(phantomDelay.symbol, SYMBOL_ASK);
         double pt = SymbolInfoDouble(phantomDelay.symbol, SYMBOL_POINT);
         double pipSz = pt * 10.0;
         double freshGapBuy = (mBid - lAsk) / pipSz;
         double freshGapSell = (lBid - mAsk) / pipSz;
         double lSpread = (pt > 0.0) ? (lAsk - lBid) / pt : 0.0;
         double costPips = lSpread / 10.0;
         double minGap = MathMax(TriggerPips, MinGapPips) + costPips;
         ENUM_GAP_DIRECTION freshDir = GAP_NONE;
         double executionGap = 0.0;
         if(freshGapBuy > minGap && freshGapSell <= minGap)
         {
            freshDir = GAP_BUY;
            executionGap = freshGapBuy;
         }
         else if(freshGapSell > minGap && freshGapBuy <= minGap)
         {
            freshDir = GAP_SELL;
            executionGap = freshGapSell;
         }
         if(freshDir != GAP_NONE && freshDir == phantomDelay.direction)
         {
            double lot = CalcLot(phantomDelay.symbol);
            ENUM_ORDER_TYPE orderType = (freshDir == GAP_BUY) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
            ExecuteTradeWithRetry(phantomDelay.symbol, orderType, lot, executionGap);
         }
         else if(freshDir == GAP_NONE)
         {
            dashMetrics.rejectedTrades++;
            Print("PHANTOM TIMEOUT: Gap closed during delay for ", phantomDelay.symbol);
         }
      }
   }
}

