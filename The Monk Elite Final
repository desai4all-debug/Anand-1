void PerformHealthCheck()
{
   int h = FeedFileOpen(MasterNodeID, FILE_READ | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      healthCheck.consecutiveFailures++;
      if(healthCheck.consecutiveFailures > 3) Alert("Feed file inaccessible: ", MasterNodeID);
      return;
   }
   FileClose(h);
   if(!SymbolSelect(symArr[0], true)) { Alert("Lost connection to broker"); return; }
   if(!healthCheck.masterOnline && TimeCurrent() - healthCheck.lastGoodFeed > FEED_TIMEOUT_SEC)
   {
      Alert("MONK ELITE: Master feed offline for > ", FEED_TIMEOUT_SEC, "s");
      return;
   }
}

void PerformFileCleanup()
{
   if(logHandle != INVALID_HANDLE && FileSize(logHandle) > MAX_LOG_SIZE_MB * 1024 * 1024)
   {
      FileClose(logHandle);
      MqlDateTime dt;
      TimeToStruct(TimeCurrent(), dt);
      string datePart = StringFormat("%04d-%02d-%02d", dt.year, dt.mon, dt.day);
      string fname = "MONK_TICKS_" + NodeID + "_" + datePart + ".csv";
      logHandle = FileOpen(fname, FILE_WRITE | FILE_COMMON | FILE_CSV | FILE_ANSI);
      if(logHandle != INVALID_HANDLE)
         FileWrite(logHandle, "Date", "Time", "Symbol", "Bid", "Ask", "Spread_pts", "WallClock_ms", "CRC_Valid", "Latency");
   }
   for(int s = 0; s < symCount; s++)
   {
      for(int n = 1; n <= 8; n++)
      {
         string fname = HEDGE_FILE_PREFIX + "NODE" + IntegerToString(n) + "_" + symArr[s] + ".bin";
         if(FileIsExist(fname, FILE_COMMON))
         {
            int h = FileOpen(fname, FILE_READ | FILE_BIN | FILE_COMMON);
            if(h != INVALID_HANDLE)
            {
               double ts = FileReadDouble(h);
               FileReadDouble(h);
               double ack = FileReadDouble(h);
               FileClose(h);
               if(ack != 0.0 || TimeCurrent() - (datetime)ts > 60) FileDelete(fname, FILE_COMMON);
            }
         }
      }
   }
}

